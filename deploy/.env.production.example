NAWEI_ENV=production
NAWEI_IMAGE_TAG=latest

# Public edge
NAWEI_DOMAIN=voice.example.com
TLS_EMAIL=ops@example.com
NAWEI_ENV_FILE=.env.production

# Robot ingress; replace these with the server's trusted HTTPS/WSS endpoints.
XIAOZHI_ENABLED=true
NAWEI_PUBLIC_ROBOT_URL=https://voice.example.com
XIAOZHI_PUBLIC_WEBSOCKET_URL=wss://voice.example.com/xiaozhi/v1/

# Gateway authentication
GATEWAY_AUTH_MODE=jwt
GATEWAY_ENABLE_DIAGNOSTICS=false
GATEWAY_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
GATEWAY_JWT_ISSUER=nawei-auth
GATEWAY_JWT_AUDIENCE=nawei-gateway

# Distinct internal service credentials
ASR_INTERNAL_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_ASR
LLM_INTERNAL_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_LLM
TTS_INTERNAL_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_TTS
TTS_ADMIN_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_TTS_ADMIN

# Gateway -> ASR / LLM / TTS
GATEWAY_ASR_URL=http://asr:8001/api/v1/audio/transcriptions/base64
GATEWAY_ASR_REALTIME_URL=ws://asr:8001/api/v1/asr/realtime
GATEWAY_LLM_URL=http://llm:8002/api/v1/llm
GATEWAY_LLM_STREAM_URL=http://llm:8002/api/v1/llm/stream
GATEWAY_TTS_URL=http://tts:19000/api/v1/audio/speech
GATEWAY_TTS_STREAM_URL=http://tts:19000/api/v1/audio/speech/stream
GATEWAY_ASR_HEALTH_URL=http://asr:8001/health
GATEWAY_LLM_HEALTH_URL=http://llm:8002/health
GATEWAY_TTS_HEALTH_URL=http://tts:19000/api/v1/status
GATEWAY_ASR_TIMEOUT_SECONDS=300
GATEWAY_LLM_TIMEOUT_SECONDS=150
GATEWAY_TTS_TIMEOUT_SECONDS=300
GATEWAY_STARTUP_WARMUP_ENABLED=true
LLM_UPSTREAM_WARMUP_ENABLED=true
LLM_UPSTREAM_WARMUP_TIMEOUT_SECONDS=5
GATEWAY_HEALTH_TIMEOUT_SECONDS=10
GATEWAY_MAX_CONCURRENT_REQUESTS=6
GATEWAY_MAX_CONCURRENT_REQUESTS_PER_USER=1
GATEWAY_MAX_QUEUED_REQUESTS=12
GATEWAY_MAX_QUEUED_REQUESTS_PER_USER=1
GATEWAY_CONCURRENCY_WAIT_TIMEOUT_SECONDS=10
GATEWAY_VOICE_TTS_SEGMENT_QUEUE_SIZE=8
# Speculative text generation; final transcript and safety checks gate playback.
GATEWAY_VOICE_PREVIEW_ENABLED=false
GATEWAY_VOICE_PREVIEW_STABLE_SECONDS=0.25
GATEWAY_VOICE_PREVIEW_MIN_CHARS=6
GATEWAY_VOICE_PREVIEW_MAX_ATTEMPTS=4
GATEWAY_VOICE_PREVIEW_FINAL_WAIT_SECONDS=8
GATEWAY_TTS_SOFT_SEGMENT_MIN_CHARS=8
GATEWAY_TTS_FIRST_SEGMENT_CHARS=6
ASR_REALTIME_END_SILENCE_MS=420
GATEWAY_TTS_EAGER_SEGMENT_CHARS=48
GATEWAY_TTS_STREAM_CHUNK_SIZE=8
GATEWAY_TTS_CONTINUATION_CHUNK_SIZE=12

# LLM service
ALIYUN_CONTENT_SAFETY_ENABLED=false
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_GREEN_REGION_ID=cn-shanghai
ALIYUN_GREEN_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
ALIYUN_CONTENT_SAFETY_TIMEOUT_SECONDS=12
LLM_PROVIDER=deepseek
LLM_API_BASE_URL=https://api.deepseek.com
LLM_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_API_KEY
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=25
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_TEXT=
LLM_THINKING_ENABLED=false
LLM_HOST=0.0.0.0
LLM_PORT=8002
LLM_WORKERS=1

# LLM-owned Agent, Skills, Tools, and persistent Memory
LLM_AGENT_ENABLED=true
LLM_AGENT_MODE=langgraph
LLM_TOOL_AGENT_MODE=langgraph
LLM_TOOL_TIMEOUT_SECONDS=6
KNOWLEDGE_WEAVING_ENABLED=true
MEMORY_ENABLED=true
LLM_MEMORY_REQUIRED=true
LLM_MEMORY_STARTUP_TIMEOUT_SECONDS=30
MEMORY_POST_TURN_MAX_PENDING=64
MEMORY_POST_TURN_TIMEOUT_SECONDS=120
MEMORY_SHUTDOWN_TIMEOUT_SECONDS=130
POSTGRES_DB=nawei
POSTGRES_USER=nawei
POSTGRES_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_POSTGRES
DATABASE_URL=postgresql://nawei:REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_POSTGRES@postgres:5432/nawei
REDIS_URL=redis://redis:6379/0
MEMORY_EXTRACTOR_ENABLED=true
MEMORY_EXTRACTOR_URL=http://llm:8002/api/v1/llm
MEMORY_PROFILE_REDIS_CACHE=true
KNOWLEDGE_ENABLED=true
KNOWLEDGE_REQUIRED=true
KNOWLEDGE_INTERNAL_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_KNOWLEDGE_INTERNAL
KNOWLEDGE_ADMIN_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_KNOWLEDGE_ADMIN
KNOWLEDGE_DEFAULT_BASE_ID=default
KNOWLEDGE_TIMEOUT_SECONDS=30
KNOWLEDGE_STARTUP_WARMUP_ENABLED=true
KNOWLEDGE_STARTUP_WARMUP_TIMEOUT_SECONDS=60
QDRANT_IMAGE=qdrant/qdrant:v1.19.0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_QDRANT
QDRANT_COLLECTION=knowledge_chunks_bge_zh_20260907
NEO4J_IMAGE=neo4j:5.26-community
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_NEO4J
NEO4J_DATABASE=neo4j
EMBEDDING_PROVIDER=fastembed
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_THREADS=2
KNOWLEDGE_GRAPH_EXTRACTOR=llm
KNOWLEDGE_LLM_EXTRACTOR_URL=http://llm:8002/api/v1/llm
KNOWLEDGE_CHUNK_SIZE=600
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_CACHE_TTL_SECONDS=600
KNOWLEDGE_MAX_CONTEXT_CHARS=6000
TIME_TOOL_ENABLED=true
CALCULATOR_TOOL_ENABLED=true
UNIT_TOOL_ENABLED=true
DICTIONARY_TOOL_ENABLED=true
ENCYCLOPEDIA_TOOL_ENABLED=true
WEATHER_TOOL_ENABLED=true
BOCHA_WEB_SEARCH_ENABLED=false

# ASR and TTS
# CPU ASR leaves the single GPU available to TTS.
ASR_DEVICE=cpu
ASR_REALTIME_BACKEND=paraformer
ASR_STREAMING_DEVICE=cpu
ASR_STREAMING_THREADS=2
ASR_STREAMING_WORKERS=2
ASR_MAX_CONCURRENT_INFERENCES=1
ASR_MAX_QUEUE_SIZE=16
ASR_QUEUE_TIMEOUT_SECONDS=30
ASR_MAX_AUDIO_BYTES=26214400
ASR_MAX_AUDIO_FILES=4
ASR_REALTIME_MAX_SESSION_SECONDS=3600
# Waiting requests only; one generation per TTS process.
TTS_MAX_QUEUE_SIZE=16
TTS_QUEUE_TIMEOUT_SECONDS=120
TTS_STREAM_QUEUE_SIZE=8
TTS_STREAM_QUEUE_PUT_TIMEOUT_SECONDS=5
VOICE_LAB_SPEAKER=liliya

# Optional observability
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
