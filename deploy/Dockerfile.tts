ARG TTS_BASE_IMAGE=pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime
FROM ${TTS_BASE_IMAGE} AS tts-models

COPY models/tts /app/models/tts
COPY models/manifest.json /app/models/manifest.json
COPY scripts/restore_models.py /app/scripts/restore_models.py
RUN python /app/scripts/restore_models.py \
        --model-root /app/models \
        --prefix tts/liliya/checkpoint-epoch-1/ \
        --remove-parts

FROM ${TTS_BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    TTS_PORT=19000 \
    HF_HOME=/app/services/tts/data/cache/huggingface \
    HF_HUB_CACHE=/app/services/tts/data/cache/huggingface/hub \
    MODELSCOPE_CACHE=/app/services/tts/data/cache/modelscope

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates ffmpeg libsndfile1 sox libsox-fmt-all \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 nawei \
    && useradd --uid 10001 --gid nawei --create-home --shell /usr/sbin/nologin nawei

COPY deploy/requirements-tts.txt /tmp/requirements-tts.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install --requirement /tmp/requirements-tts.txt

WORKDIR /app/services/tts
COPY --chown=nawei:nawei services/tts /app/services/tts
COPY --from=tts-models --chown=nawei:nawei /app/models/tts /app/models/tts
COPY --from=tts-models --chown=nawei:nawei /app/models/manifest.json /app/models/manifest.json
RUN mkdir -p /app/services/tts/data/cache /app/services/tts/data/logs /app/services/tts/data/sessions \
        /app/services/tts/voice_lab/output \
    && chown -R nawei:nawei /app/services/tts/data /app/services/tts/voice_lab/output

USER nawei

EXPOSE 19000
CMD ["python", "-m", "app.services.tts.server", "--port", "19000"]
