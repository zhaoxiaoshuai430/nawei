# Four-module chain: Gateway -> ASR -> LLM -> TTS
NAWEI_ENV=development

# LLM service (agent02 implementation adapted to port 8002).
LLM_PROVIDER=stub
LLM_API_BASE_URL=https://api.deepseek.com
LLM_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_API_KEY
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=25
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_TEXT=
LLM_THINKING_ENABLED=false
LLM_HOST=127.0.0.1
LLM_PORT=8002
LLM_WORKERS=4

# LLM-owned Agent, Skills, Tools, and persistent Memory.
LLM_AGENT_ENABLED=true
LLM_AGENT_MODE=langgraph
LLM_TOOL_AGENT_MODE=langgraph
LLM_TOOL_TIMEOUT_SECONDS=6
MEMORY_ENABLED=true
LLM_MEMORY_REQUIRED=true
DATABASE_URL=postgresql://nawei:nawei@127.0.0.1:5432/nawei
REDIS_URL=redis://127.0.0.1:6379/0
MEMORY_EXTRACTOR_ENABLED=true
MEMORY_EXTRACTOR_URL=http://127.0.0.1:8002/api/v1/llm
MEMORY_PROFILE_REDIS_CACHE=true

# LLM runtime tools.
TIME_TOOL_ENABLED=true
CALCULATOR_TOOL_ENABLED=true
UNIT_TOOL_ENABLED=true
DICTIONARY_TOOL_ENABLED=true
ENCYCLOPEDIA_TOOL_ENABLED=true
WEATHER_TOOL_ENABLED=true
WEATHER_PROVIDER=open_meteo
BOCHA_WEB_SEARCH_ENABLED=false
# BOCHA_API_KEY=REPLACE_WITH_YOUR_BOCHA_API_KEY

# Gateway upstreams.
GATEWAY_ASR_URL=http://127.0.0.1:8001/api/v1/audio/transcriptions/base64
GATEWAY_ASR_REALTIME_URL=ws://127.0.0.1:8001/api/v1/asr/realtime
GATEWAY_LLM_URL=http://127.0.0.1:8002/api/v1/llm
GATEWAY_LLM_STREAM_URL=http://127.0.0.1:8002/api/v1/llm/stream
GATEWAY_TTS_URL=http://127.0.0.1:19000/api/v1/audio/speech
GATEWAY_TTS_STREAM_URL=http://127.0.0.1:19000/api/v1/audio/speech/stream
GATEWAY_ASR_TIMEOUT_SECONDS=300
GATEWAY_LLM_TIMEOUT_SECONDS=60
GATEWAY_TTS_TIMEOUT_SECONDS=300
GATEWAY_HEALTH_TIMEOUT_SECONDS=3

# Use independent random values of at least 32 bytes in production.
# ASR_INTERNAL_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# LLM_INTERNAL_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# TTS_INTERNAL_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Gateway authentication.
GATEWAY_AUTH_MODE=local
GATEWAY_ALLOW_BODY_USER_ID=0
# GATEWAY_AUTH_MODE=jwt
# GATEWAY_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# GATEWAY_JWT_ISSUER=nawei-auth
# GATEWAY_JWT_AUDIENCE=nawei-gateway

# Gateway concurrency. Conversation state is owned by LLM Memory.
GATEWAY_MAX_CONCURRENT_REQUESTS=20
GATEWAY_MAX_CONCURRENT_REQUESTS_PER_USER=2
GATEWAY_MAX_QUEUED_REQUESTS=100
GATEWAY_MAX_QUEUED_REQUESTS_PER_USER=4
GATEWAY_CONCURRENCY_WAIT_TIMEOUT_SECONDS=10
GATEWAY_VOICE_EVENT_QUEUE_SIZE=64

# ASR admission and realtime segmentation.
ASR_MAX_CONCURRENT_INFERENCES=1
ASR_MAX_QUEUE_SIZE=16
ASR_QUEUE_TIMEOUT_SECONDS=30
ASR_REALTIME_RMS_THRESHOLD=500
ASR_REALTIME_START_MS=60
ASR_REALTIME_END_SILENCE_MS=600
ASR_REALTIME_PRE_ROLL_MS=200
ASR_REALTIME_MIN_SPEECH_MS=180
ASR_REALTIME_MAX_SEGMENT_SECONDS=20
ASR_REALTIME_MAX_SESSION_SECONDS=120
ASR_REALTIME_SEGMENT_QUEUE_SIZE=4

# TTS admission and streaming.
TTS_MAX_QUEUE_SIZE=8
TTS_QUEUE_TIMEOUT_SECONDS=120
TTS_STREAM_QUEUE_SIZE=8
TTS_STREAM_QUEUE_PUT_TIMEOUT_SECONDS=5

# Docker production URLs use service names:
# GATEWAY_ASR_URL=http://asr:8001/api/v1/audio/transcriptions/base64
# GATEWAY_ASR_REALTIME_URL=ws://asr:8001/api/v1/asr/realtime
# GATEWAY_LLM_URL=http://llm:8002/api/v1/llm
# GATEWAY_LLM_STREAM_URL=http://llm:8002/api/v1/llm/stream
# GATEWAY_TTS_URL=http://tts:19000/api/v1/audio/speech
# GATEWAY_TTS_STREAM_URL=http://tts:19000/api/v1/audio/speech/stream
