# Four-module chain: Gateway -> ASR -> LLM -> TTS
NAWEI_ENV=development

# Single Gateway instance; set the cloud server HTTPS/WSS URLs for production.
XIAOZHI_ENABLED=true
XIAOZHI_DATABASE_PATH=.runtime/devices.sqlite3
NAWEI_PUBLIC_API_URL=http://127.0.0.1:8000
NAWEI_PUBLIC_ROBOT_URL=http://127.0.0.1:8000
XIAOZHI_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:8000/xiaozhi/v1/
XIAOZHI_ACTIVATION_TTL_SECONDS=600
XIAOZHI_ALLOW_LEGACY_DEVICES=false
XIAOZHI_LEGACY_DEVICE_SECRET=
XIAOZHI_HELLO_TIMEOUT_SECONDS=10
XIAOZHI_HEARTBEAT_INTERVAL_SECONDS=25

# LLM service (agent02 implementation adapted to port 8002).
LLM_PROVIDER=stub
LLM_API_BASE_URL=https://api.deepseek.com
LLM_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_API_KEY
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=25
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_TEXT=
LLM_THINKING_ENABLED=false
LLM_HOST=127.0.0.1
LLM_PORT=8002
LLM_WORKERS=4

# LLM-owned Agent, Skills, Tools, and persistent Memory.
LLM_AGENT_ENABLED=true
LLM_AGENT_MODE=langgraph
LLM_TOOL_AGENT_MODE=langgraph
LLM_TOOL_SELECTION_MODE=native
LLM_DEFAULT_ANSWER_MODE=standard
LLM_FAST_MEMORY_MODE=auto
LLM_FAST_POST_TURN_MODE=history_only
MEMORY_POST_TURN_ASYNC=true
MEMORY_POST_TURN_MAX_PENDING=64
MEMORY_POST_TURN_TIMEOUT_SECONDS=120
MEMORY_SHUTDOWN_TIMEOUT_SECONDS=130
MEMORY_TOOLS_ENABLED=true
LLM_DIRECT_TOOL_ANSWER_ENABLED=true
LLM_DIRECT_WEB_SEARCH_ANSWER_ENABLED=true
LLM_SEND_TOOL_RESULTS_TO_LLM=false
LLM_TOOL_PLANNER_TIMEOUT_SECONDS=6
LLM_TOOL_PLANNER_MAX_CALLS=3
LLM_TOOL_TIMEOUT_SECONDS=6
KNOWLEDGE_WEAVING_ENABLED=true

# Deterministic LLM safety checks and structured audit logging.
SAFETY_ENABLED=true
SAFETY_INPUT_ENABLED=true
SAFETY_TOOL_RESULT_ENABLED=true
SAFETY_OUTPUT_ENABLED=true
SAFETY_PRIVACY_MASK_ENABLED=true
SAFETY_AUDIT_LOG_ENABLED=true
SAFETY_STREAM_BUFFER_CHARS=24
LLM_STREAM_CHUNK_CHARS=1

MEMORY_ENABLED=true
LLM_MEMORY_REQUIRED=true
LLM_MEMORY_STARTUP_TIMEOUT_SECONDS=30
DATABASE_URL=postgresql://nawei:nawei@127.0.0.1:5432/nawei
REDIS_URL=redis://127.0.0.1:6379/0
MEMORY_EXTRACTOR_ENABLED=true
MEMORY_EXTRACTOR_URL=http://127.0.0.1:8002/api/v1/llm
MEMORY_PROFILE_REDIS_CACHE=true

# Knowledge GraphRAG: Qdrant vectors + Neo4j graph.
KNOWLEDGE_ENABLED=true
KNOWLEDGE_REQUIRED=false
KNOWLEDGE_HOST=127.0.0.1
KNOWLEDGE_PORT=8003
KNOWLEDGE_RETRIEVE_URL=http://127.0.0.1:8003/api/v1/knowledge/retrieve
KNOWLEDGE_HEALTH_URL=http://127.0.0.1:8003/health
KNOWLEDGE_DEFAULT_BASE_ID=default
KNOWLEDGE_TIMEOUT_SECONDS=30
KNOWLEDGE_STARTUP_WARMUP_ENABLED=true
KNOWLEDGE_STARTUP_WARMUP_TIMEOUT_SECONDS=60
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=nawei-qdrant-local
QDRANT_COLLECTION=knowledge_chunks_v1
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nawei-neo4j-local
NEO4J_DATABASE=neo4j
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-embedding-v1
EMBEDDING_DIMENSION=128
KNOWLEDGE_GRAPH_EXTRACTOR=rules
KNOWLEDGE_LLM_EXTRACTOR_URL=http://127.0.0.1:8002/api/v1/llm
KNOWLEDGE_CHUNK_SIZE=600
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_CACHE_TTL_SECONDS=600
KNOWLEDGE_MAX_CONTEXT_CHARS=6000
# KNOWLEDGE_INTERNAL_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# KNOWLEDGE_ADMIN_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# LLM runtime tools.
TIME_TOOL_ENABLED=true
CALCULATOR_TOOL_ENABLED=true
UNIT_TOOL_ENABLED=true
DICTIONARY_TOOL_ENABLED=true
ENCYCLOPEDIA_TOOL_ENABLED=true
WEATHER_TOOL_ENABLED=true
WEATHER_PROVIDER=open_meteo
BOCHA_WEB_SEARCH_ENABLED=false
# BOCHA_API_KEY=REPLACE_WITH_YOUR_BOCHA_API_KEY

# Gateway upstreams.
GATEWAY_ASR_URL=http://127.0.0.1:8001/api/v1/audio/transcriptions/base64
GATEWAY_ASR_REALTIME_URL=ws://127.0.0.1:8001/api/v1/asr/realtime
GATEWAY_LLM_URL=http://127.0.0.1:8002/api/v1/llm
GATEWAY_LLM_STREAM_URL=http://127.0.0.1:8002/api/v1/llm/stream
GATEWAY_TTS_URL=http://127.0.0.1:19000/api/v1/audio/speech
GATEWAY_TTS_STREAM_URL=http://127.0.0.1:19000/api/v1/audio/speech/stream
GATEWAY_ASR_TIMEOUT_SECONDS=300
GATEWAY_LLM_TIMEOUT_SECONDS=150
GATEWAY_TTS_TIMEOUT_SECONDS=300
GATEWAY_HEALTH_TIMEOUT_SECONDS=10
GATEWAY_STARTUP_WARMUP_ENABLED=true

# Optional ASR transcript keyword filter: ASR -> keyword API -> fallback or LLM Agent.
# LLM input/output moderation. Keep the Gateway filter off to avoid duplicate input reviews.
ALIYUN_CONTENT_SAFETY_ENABLED=false
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_GREEN_REGION_ID=cn-shanghai
ALIYUN_GREEN_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
ALIYUN_CONTENT_SAFETY_TIMEOUT_SECONDS=12
GATEWAY_KEYWORD_FILTER_ENABLED=false
# GATEWAY_KEYWORD_FILTER_URL=https://keyword-filter.example/api/check
GATEWAY_KEYWORD_FILTER_TIMEOUT_SECONDS=3
GATEWAY_KEYWORD_FILTER_FAILURE_MODE=closed
GATEWAY_KEYWORD_FILTER_FALLBACK_TEXT=抱歉，这个话题我暂时不能回答。我们换一个安全、合适的话题吧。
GATEWAY_KEYWORD_FILTER_TEXT_FIELD=text
GATEWAY_KEYWORD_FILTER_BLOCKED_FIELD=blocked
# Set this instead when the provider returns an allow/safe flag, for example data.safe.
# GATEWAY_KEYWORD_FILTER_ALLOWED_FIELD=data.safe
GATEWAY_KEYWORD_FILTER_MATCHED_KEYWORDS_FIELD=matched_keywords
GATEWAY_KEYWORD_FILTER_REASON_FIELD=reason
# GATEWAY_KEYWORD_FILTER_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
GATEWAY_KEYWORD_FILTER_API_KEY_HEADER=Authorization
GATEWAY_KEYWORD_FILTER_API_KEY_PREFIX=Bearer

# Use independent random values of at least 32 bytes in production.
# ASR_INTERNAL_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# LLM_INTERNAL_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# TTS_INTERNAL_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Gateway authentication.
GATEWAY_AUTH_MODE=local
GATEWAY_ALLOW_BODY_USER_ID=0
GATEWAY_ENABLE_DIAGNOSTICS=true
# GATEWAY_AUTH_MODE=jwt
# GATEWAY_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# GATEWAY_JWT_ISSUER=nawei-auth
# GATEWAY_JWT_AUDIENCE=nawei-gateway

# Gateway concurrency. Conversation state is owned by LLM Memory.
GATEWAY_MAX_CONCURRENT_REQUESTS=20
GATEWAY_MAX_CONCURRENT_REQUESTS_PER_USER=2
GATEWAY_MAX_QUEUED_REQUESTS=100
GATEWAY_MAX_QUEUED_REQUESTS_PER_USER=4
GATEWAY_CONCURRENCY_WAIT_TIMEOUT_SECONDS=10
GATEWAY_VOICE_TTS_SEGMENT_QUEUE_SIZE=8
GATEWAY_TTS_SOFT_SEGMENT_MIN_CHARS=8
GATEWAY_TTS_FIRST_SEGMENT_CHARS=6
GATEWAY_TTS_EAGER_SEGMENT_CHARS=48
GATEWAY_TTS_STREAM_CHUNK_SIZE=8
GATEWAY_TTS_CONTINUATION_CHUNK_SIZE=12
GATEWAY_VOICE_EVENT_QUEUE_SIZE=64

# ASR admission and realtime segmentation.
# Windows launcher enables paraformer after preparing models/asr/paraformer-online.
# Set ASR_REALTIME_BACKEND=sensevoice in the launching shell for legacy realtime.
# Direct standalone launch defaults to sensevoice; opt in with the same variable.
# ASR_REALTIME_BACKEND=paraformer
ASR_STREAMING_DEVICE=cpu
ASR_STREAMING_THREADS=2
# Independent online models; connections retain one worker for their lifetime.
ASR_STREAMING_WORKERS=2
ASR_MAX_CONCURRENT_INFERENCES=1
ASR_MAX_QUEUE_SIZE=16
ASR_QUEUE_TIMEOUT_SECONDS=30
ASR_MAX_AUDIO_BYTES=26214400
ASR_MAX_AUDIO_FILES=4
ASR_REALTIME_RMS_THRESHOLD=500
ASR_REALTIME_START_MS=60
ASR_REALTIME_END_SILENCE_MS=420
ASR_REALTIME_PRE_ROLL_MS=200
ASR_REALTIME_MIN_SPEECH_MS=180
ASR_REALTIME_MAX_SEGMENT_SECONDS=20
ASR_REALTIME_MAX_SESSION_SECONDS=3600
ASR_REALTIME_SEGMENT_QUEUE_SIZE=4
ASR_TEXT_CORRECTIONS_ENABLED=true
ASR_TEXT_CORRECTIONS_INCLUDE_DEFAULTS=true
# JSON object of context-specific phrases; avoid single-character global replacements.
# ASR_TEXT_CORRECTIONS_JSON={"小为同学":"小维同学"}

# Warm the persistent DeepSeek HTTP/TLS connection without sending a completion request.
LLM_UPSTREAM_WARMUP_ENABLED=true
LLM_UPSTREAM_WARMUP_TIMEOUT_SECONDS=5

# TTS admission and streaming.
# Waiting requests only; the GPU model still runs one generation at a time.
TTS_MAX_QUEUE_SIZE=16
TTS_QUEUE_TIMEOUT_SECONDS=120
TTS_STREAM_QUEUE_SIZE=8
TTS_STREAM_QUEUE_PUT_TIMEOUT_SECONDS=5

# Docker production URLs use service names:
# GATEWAY_ASR_URL=http://asr:8001/api/v1/audio/transcriptions/base64
# GATEWAY_ASR_REALTIME_URL=ws://asr:8001/api/v1/asr/realtime
# GATEWAY_LLM_URL=http://llm:8002/api/v1/llm
# GATEWAY_LLM_STREAM_URL=http://llm:8002/api/v1/llm/stream
# GATEWAY_TTS_URL=http://tts:19000/api/v1/audio/speech
# GATEWAY_TTS_STREAM_URL=http://tts:19000/api/v1/audio/speech/stream
VOICE_LAB_SPEAKER=liliya

# Prepare a text answer while ASR is listening; only play after final validation.
GATEWAY_VOICE_PREVIEW_ENABLED=false
GATEWAY_VOICE_PREVIEW_STABLE_SECONDS=0.25
GATEWAY_VOICE_PREVIEW_MIN_CHARS=6
GATEWAY_VOICE_PREVIEW_MAX_ATTEMPTS=4
GATEWAY_VOICE_PREVIEW_FINAL_WAIT_SECONDS=8
