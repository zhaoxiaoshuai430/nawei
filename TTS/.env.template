# nana TTS 独立部署 — 复制为项目根目录 .env
VOICE_LAB_SPEAKER=nana
TTS_DEFAULT_MODEL=voice_lab/nana
TTS_PORT=19000

# Optional: required for POST /api/v1/models/load from non-loopback clients.
# TTS_ADMIN_API_KEY=replace-with-a-long-random-value

# 国内下载 HuggingFace 模型（首次启动需要联网）
HF_ENDPOINT=https://hf-mirror.com

# 可选：固定 checkpoint（默认自动选最新 epoch-7）
# VOICE_LAB_CHECKPOINT=voice_lab/output/nana/checkpoint-epoch-7
